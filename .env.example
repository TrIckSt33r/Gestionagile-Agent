# Gestionagile Monitor Agent — Configurazione
# Copia in /etc/monitor-agent/.env (chmod 600, owner monitor-agent:monitor-agent)

# Obbligatori: token e URL del tuo server Gestionagile
AGENT_TOKEN=il_tuo_token_da_32_caratteri
AGENT_URL=https://tuo-gestionagile.example.com/api/agent/report

# Opzionali
AGENT_INTERVAL=4              # secondi tra invii (min 4 per rate limit server)
AGENT_DISK_PATH=/             # percorso da monitorare per spazio disco
AGENT_STATE_FILE=/var/lib/monitor-agent/state.json  # persistenza contatori rete
AGENT_HMAC_KEY=la_tua_chiave_hmac_da_32_caratteri   # da "Chiave HMAC (X-Signature)" in UI